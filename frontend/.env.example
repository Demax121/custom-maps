# API Endpoints Configuration
# Copy this file to .env and update with your actual values
VITE_MAP_NAME=YourMapName

# Individual endpoint URLs (constructed from base)
VITE_MAP_DATA_ENDPOINT=http://your-api-server/getMapData.php?map_name=${VITE_MAP_NAME}
VITE_MARKERS_DATA_ENDPOINT=http://your-api-server/getMarkersData.php?map_name=${VITE_MAP_NAME}
VITE_OVERLAYS_DATA_ENDPOINT=http://your-api-server/getOverlaysData.php?map_name=${VITE_MAP_NAME}
VITE_ICONS_BASE_URL=http://your-api-server/icons/